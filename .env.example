# Leave unset and the desk is open. Set a passphrase to lock the portal.
INSTABOT_PASSWORD=

# Facebook Login for the Connect Instagram button. All three are required to start login.
# META_REDIRECT_URI is the redirect URL registered on the Meta app, for example
# https://your-desk.example/api/instagram/callback
# Scopes: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement.
# The access token and Instagram user id are stored in the database, not in this file.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Optional fallback when Connect Instagram has not stored a login yet.
# When either is missing and nothing is stored, the reel stays silent, approve does not post,
# and the mp4 stays downloadable.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Unused. Stills come from Pexels.
UNSPLASH_ACCESS_KEY=
# Optional. Creator and Generate search Pexels. Without a key, the desk reads the public search pages.
PEXELS_API_KEY=

# Production queue, caption banks, and used captions. Both are required.
# Leave unset locally and the desk keeps using data/instabot.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production mp4s. Leave unset locally and files stay in data/renders.
# On Vercel, connect a public Blob store. OIDC uses instabot_STORE_ID or BLOB_STORE_ID.
# A read-write token is only needed when that store id is unset (off Vercel).
BLOB_READ_WRITE_TOKEN=
