# Leave unset and the desk is open. Set a passphrase to lock the portal.
INSTABOT_PASSWORD=

# Instagram API with Facebook Login. Both are required to search the catalog and publish.
# Permissions: instagram_basic, instagram_content_publish, and a linked Facebook Page.
# When either is missing, the reel stays silent, approve does not post, and the mp4 stays downloadable.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Reserved for a later stills source. This version uses the bundled Unsplash photos.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Production queue, caption banks, and used captions. Both are required.
# Leave unset locally and the desk keeps using data/instabot.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Production mp4s. Leave unset locally and files stay in data/renders.
# On Vercel, connect a public Blob store. OIDC uses instabot_STORE_ID or BLOB_STORE_ID.
# A read-write token is only needed when that store id is unset (off Vercel).
BLOB_READ_WRITE_TOKEN=
