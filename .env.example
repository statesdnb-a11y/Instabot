# Leave unset and the desk is open. Set a passphrase to lock the portal.
INSTABOT_PASSWORD=

# Instagram API with Facebook Login. Both are required to search the catalog and publish.
# Permissions: instagram_basic, instagram_content_publish, and a linked Facebook Page.
# When either is missing, the reel stays silent, approve does not post, and the mp4 stays downloadable.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Reserved for a later stills source. This version uses the bundled Unsplash photos.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
